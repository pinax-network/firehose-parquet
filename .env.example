# Firehose Parquet — Environment Variables
#
# Copy this file to .env and adjust the values to your needs. `fireparq` loads
# .env from the working directory at startup.
# Configuration variables map to the CLI flags (`env = "..."` in the clap
# definitions); credential variables hold secrets. CLI flags take precedence
# over environment variables. Commented values show the built-in defaults.
# A test in blocks/src/bin/main.rs keeps this list in sync with the CLI.
#
# ---------------------------------------------------------------------------
# Authentication (see README "Authentication")
# ---------------------------------------------------------------------------
# Selected automatically only for built-in provider hosts over HTTPS on port 443.
# Provider-specific variables take precedence over the legacy Pinax-only fallbacks.
PINAX_API_KEY=your-pinax-api-key-here
# PINAX_API_TOKEN=your-pinax-jwt-token-here
# STREAMINGFAST_API_KEY=your-streamingfast-api-key-here
# STREAMINGFAST_API_TOKEN=your-streamingfast-compatible-token-here
# SUBSTREAMS_API_KEY=legacy-pinax-only-api-key-here
# SUBSTREAMS_API_TOKEN=legacy-pinax-only-jwt-token-here
#
# Explicitly authorize a credential name for the selected endpoint, whatever its
# host (--api-key-envvar / --api-token-envvar). Do not set these globally to a
# Pinax credential such as SUBSTREAMS_API_KEY: every endpoint, including
# StreamingFast and custom hosts, would then receive it (startup logs a warning).
# API_KEY_ENVVAR=MY_FIREHOSE_API_KEY
# API_TOKEN_ENVVAR=MY_FIREHOSE_API_TOKEN
#
# ---------------------------------------------------------------------------
# Connection
# ---------------------------------------------------------------------------
# NETWORK=mainnet
# ENDPOINT=https://eth.firehose.pinax.network:443
# Per-network endpoint override for --network, e.g. FIREHOSE_ENDPOINT_MAINNET or
# FIREHOSE_ENDPOINT_SOLANA_MAINNET_BETA:
# FIREHOSE_ENDPOINT_MAINNET=https://eth.firehose.internal.example:443
# Force a reconnect after N seconds without a stream message (0 disables)
# STREAM_IDLE_TIMEOUT_SECS=120
# Exit with an error after reconnecting continuously for N seconds (0 disables)
# RECONNECT_STALL_TIMEOUT_SECS=900
# Adapt HTTP/2 receive windows to measured bandwidth/latency
# GRPC_ADAPTIVE_WINDOW=false
# Initial HTTP/2 stream/connection receive window (0 uses library defaults)
# GRPC_WINDOW_BYTES=16777216
# Maximum encoded or decompressed gRPC response size (at least 1)
# GRPC_MAX_MESSAGE_BYTES=134217728
#
# ---------------------------------------------------------------------------
# Block range and resume
# ---------------------------------------------------------------------------
# START_BLOCK=0
# Exclusive; omit for live mode
# STOP_BLOCK=
# CURSOR=cursor.parquet
# CURSOR_TEMPLATE=
# CURSOR_OVERRIDE=false
# Only finalized blocks; false appends NEW/UNDO rows with fork_step
# FINAL_BLOCKS_ONLY=true
#
# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------
# auto, evm, bitcoin, solana, near, antelope, cosmos, tron, beacon
# BLOCK_TYPE=auto
# WITHOUT_EXTENDED=false
# WITHOUT_VOTES=false
# INCLUDE_FAILED_TRANSACTIONS=false
# EXCLUDE_FAILED_TRANSACTIONS=false
#
# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
# Local directory or s3://bucket/prefix
# OUTPUT=.
# none, block_range, date, hour, minute, second
# PARTITION=none
# BLOCK_RANGE_SIZE=10000
# zstd (level 3), zstd:<level>, snappy, gzip, none
# COMPRESSION=zstd
#
# ---------------------------------------------------------------------------
# Flush tuning (0 disables FLUSH_ROWS, FLUSH_BYTES and FLUSH_INTERVAL_SECS)
# ---------------------------------------------------------------------------
# Rows in the largest table (unset disables)
# FLUSH_ROWS=
# Processed blocks (at least 1; unset disables)
# FLUSH_BLOCKS=
# Target compressed bytes in the largest table file (32 MiB)
# FLUSH_BYTES=33554432
# Summed mapper byte estimate, not RSS (256 MiB; at least 1)
# FLUSH_MEMORY_BYTES=268435456
# Seconds between flushes (unset disables)
# FLUSH_INTERVAL_SECS=
#
# ---------------------------------------------------------------------------
# Runtime, logging and metrics
# ---------------------------------------------------------------------------
# trace, debug, info, warn, error
# LOG_LEVEL=info
# VERBOSE=false
# DRY_RUN=false
# Serve Prometheus /metrics, /health and /ready on 0.0.0.0:<port>
# METRICS_PORT=9102
# /ready returns 503 after N seconds without a valid stream message (at least 1)
# METRICS_STALE_AFTER_SECS=120
#
# ---------------------------------------------------------------------------
# AWS S3 (set OUTPUT=s3://bucket/prefix to write to S3)
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL_S3=
# `fireparq recovery` reads its S3-compatible endpoint from AWS_ENDPOINT_URL instead
# AWS_ENDPOINT_URL=
# S3_BUCKET=
# Cache-Control header for S3 uploads (empty = no header)
# CACHE_CONTROL=public, max-age=31536000, immutable
