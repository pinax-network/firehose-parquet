# Firehose Parquet — Environment Variables
#
# Copy this file to .env and adjust the values to your needs.
# All variables below map 1-to-1 to CLI flags of the same name.
# CLI flags take precedence over environment variables.
#
# Authentication — these env vars hold the actual secrets.
# The CLI flags --api-key-envvar and --api-token-envvar specify
# which env var names to read (defaults below).
SUBSTREAMS_API_KEY=your-api-key-here
SUBSTREAMS_API_TOKEN=your-jwt-token-here
#
# Public endpoint — skip authentication
# PUBLIC=false
#
# Connection
# ENDPOINT=https://eth.firehose.pinax.network:443
#
# Block range
# START_BLOCK=0
# STOP_BLOCK=0
# CURSOR=cursor.txt
#
# Output
# OUTPUT=output
# PARTITION=none
# BLOCK_RANGE_SIZE=10000
#
# Flush tuning
# FLUSH_ROWS=
# FLUSH_BYTES=134217728
# FLUSH_INTERVAL_SECS=
#
# Compression: zstd, snappy, gzip, none
# COMPRESSION=zstd
#
# Logging: trace, debug, info, warn, error
# LOG_LEVEL=info
#
# Pipeline behaviour
# DRY_RUN=false
# FINAL_BLOCKS_ONLY=true
#
# Byte encoding: binary, hex, base58, tron_base58, auto
# BYTES_ENCODING=hex
#
# EVM only: include extended detail (calls, balance_changes, etc.)
# EXTENDED=false
#
# AWS S3 output — set OUTPUT=s3://bucket/prefix to write to S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=
