# Firehose Parquet — Environment Variables
#
# Copy this file to .env and adjust the values to your needs.
# Configuration variables map to CLI flags; credential variables hold secrets.
# CLI flags take precedence over environment variables.
#
# Authentication — automatically selected only for known HTTPS provider hosts.
# Provider-specific variables take precedence over legacy Pinax-only fallbacks.
PINAX_API_KEY=your-pinax-api-key-here
# PINAX_API_TOKEN=your-pinax-jwt-token-here
# STREAMINGFAST_API_KEY=your-streamingfast-api-key-here
# STREAMINGFAST_API_TOKEN=your-streamingfast-compatible-token-here
# SUBSTREAMS_API_KEY=legacy-pinax-api-key-here
# SUBSTREAMS_API_TOKEN=legacy-pinax-jwt-token-here
# Explicitly authorize custom credential names for the selected endpoint:
# API_KEY_ENVVAR=MY_FIREHOSE_API_KEY
# API_TOKEN_ENVVAR=MY_FIREHOSE_API_TOKEN
#
# Connection
# ENDPOINT=https://eth.firehose.pinax.network:443
# STREAM_IDLE_TIMEOUT_SECS=120
# RECONNECT_STALL_TIMEOUT_SECS=900
#
# Block range
# START_BLOCK=0
# STOP_BLOCK=0
# CURSOR=cursor.txt
#
# Output
# OUTPUT=.
# PARTITION=none
# BLOCK_RANGE_SIZE=10000
#
# Flush tuning
# FLUSH_ROWS=
# FLUSH_BYTES=134217728
# FLUSH_INTERVAL_SECS=
#
# Compression: zstd, snappy, gzip, none
# COMPRESSION=zstd
#
# Logging: trace, debug, info, warn, error
# LOG_LEVEL=info
#
# Pipeline behaviour
# DRY_RUN=false
# FINAL_BLOCKS_ONLY=true
#
# Byte encoding: binary, hex, base58, tron_base58, auto
# BYTES_ENCODING=hex
#
# EVM only: include extended detail (calls, balance_changes, etc.)
# EXTENDED=false
#
# AWS S3 output — set OUTPUT=s3://bucket/prefix to write to S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL_S3=
# S3_BUCKET=
#
# Cache-Control header for S3 uploads (empty = no header)
# CACHE_CONTROL=public, max-age=31536000, immutable
